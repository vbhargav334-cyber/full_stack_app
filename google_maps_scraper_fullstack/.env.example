# Flask Configuration
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=8000

# Security — set these in production
# FLASK_SECRET_KEY=<random-hex-string>     # used for session signing; auto-generated if unset
# API_SECRET_KEY=<your-api-key>            # when set, all /api/ routes require Authorization: Bearer <key>
# CORS_ALLOWED_ORIGIN=http://localhost:8000 # restrict CORS to a specific origin

# File Upload Limits (in MB)
MAX_BULK_FILE_SIZE=10
MAX_CHECKPOINT_FILE_SIZE=50

# Scraper Defaults
DEFAULT_HEADLESS=True
DEFAULT_MAX_RETRIES=3
DEFAULT_MIN_DELAY=0.9
DEFAULT_MAX_DELAY=1.8
